{
  "tasks": {
    "test": "deno test --allow-all --no-check supabase/functions/",
    "test:file": "deno test --allow-all --no-check",
    "fmt": "deno fmt supabase/functions/",
    "lint": "deno lint supabase/functions/",
    "check": "deno check supabase/functions/**/*.ts"
  },
  "lint": {
    "exclude": ["**/_test/**", "**/.deno/**"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "exclude": ["**/_test/**", "**/.deno/**"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  },
  "nodeModulesDir": "none"
}